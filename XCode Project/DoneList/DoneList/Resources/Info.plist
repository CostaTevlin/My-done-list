<?xml version="1.0" encoding="UTF-8"?>
<!--
    Custom Info.plist keys ONLY.

    Xcode auto-generates the system keys (CFBundleIdentifier, CFBundleVersion,
    CFBundleExecutable, etc.) from build settings (PRODUCT_BUNDLE_IDENTIFIER,
    MARKETING_VERSION, ...) when GENERATE_INFOPLIST_FILE = YES.

    Anything Xcode can populate via INFOPLIST_KEY_* build settings goes there.
    Only keys Xcode can't auto-generate (CFBundleURLTypes added in
    Phase 7) live here.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>UIRequiresFullScreen</key>
    <true/>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>My Done List uses speech recognition to let you quickly log what you've done by speaking.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>My Done List uses the microphone to capture your voice when logging a done item.</string>
</dict>
</plist>
